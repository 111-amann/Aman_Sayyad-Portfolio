# -----------------------------------------------------------------------------
# Frontend Configuration (Public)
# Exposed to client bundle via Vite's `import.meta.env`
# -----------------------------------------------------------------------------
VITE_SERVICE_ID=your_emailjs_service_id
VITE_TEMPLATE_ID=your_emailjs_template_id
VITE_PUBLIC_KEY=your_emailjs_public_key

# Public verification endpoint URL
# In local development: leave empty or use /api/validate-email (handled by local server/Vite proxy)
# In production on GitHub Pages: point to your deployed serverless verification API URL
# Example: https://aman-sayyad-portfolio-api.vercel.app/api/validate-email
VITE_VERIFY_EMAIL_URL=/api/validate-email

# -----------------------------------------------------------------------------
# Backend / Serverless Secret Configuration (PROTECTED)
# DO NOT add the VITE_ prefix to this variable.
# Configure this in your backend server or serverless hosting provider (e.g. Vercel dashboard).
# -----------------------------------------------------------------------------
ABSTRACT_API_KEY=your_abstract_api_key_here
